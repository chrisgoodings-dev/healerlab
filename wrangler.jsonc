{
  "name": "healerlab",
  "main": "./worker.js",
  "compatibility_date": "2026-08-16",
  "vars": {
    "BLIZZARD_CLIENT_ID": "c02a86b8ca7e4800b1e3a29c430808e3"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "secrets": {
    "required": [
      "BLIZZARD_CLIENT_SECRET"
    ]
  }
}
